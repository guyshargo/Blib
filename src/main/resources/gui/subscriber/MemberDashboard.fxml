<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-scroll" stylesheets="@MemberDashboard.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.subscriber.MemberDashboardController">
    <content>
        <VBox styleClass="shelf-container">
            <children>
                
                <!-- Top Shelf: Currently Borrowed -->
                <VBox>
                    <children>
                        <Label styleClass="shelf-title" text="Currently reading" />
                        <HBox styleClass="shelf-row">
                            <children>
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Middle Shelf: Top Rated / Book of the Week -->
                <VBox>
                    <children>
                        <Label styleClass="shelf-title" text="Top rated books" />
                        <HBox styleClass="shelf-row">
                            <children>
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Bottom Shelf: Latest Arrivals -->
                <VBox>
                    <children>
                        <Label styleClass="shelf-title" text="Latest arrivals" />
                        <HBox styleClass="shelf-row">
                            <children>
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                                <VBox styleClass="book-card-placeholder" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>