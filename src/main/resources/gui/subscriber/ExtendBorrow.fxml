<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" stylesheets="@ExtendBorrow.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.subscriber.ExtendBorrowController">
   <children>
      <Label alignment="TOP_CENTER" prefHeight="36.0" prefWidth="303.0" styleClass="label-text" text="Search Borrowed Books">
         <font>
            <Font size="20.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Label>
      <HBox alignment="CENTER" prefHeight="62.0" prefWidth="800.0" spacing="20.0">
         <children>
            <Label styleClass="headlines" text="Copy of book ID:">
               <font>
                  <Font name="Assistant SemiBold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="copyOfBookIDTxt" prefHeight="31.0" prefWidth="139.0" styleClass="text-field" />
         </children>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </HBox>
      <VBox alignment="CENTER" prefHeight="254.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER" prefHeight="252.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="borrowedTable" prefHeight="243.0" prefWidth="667.0" styleClass="table-row-cell" HBox.hgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="borrowedIDColumn" text="Borrowed book ID" />
                        <TableColumn fx:id="bookNameColumn" text="Name" />
                        <TableColumn fx:id="returnDateColumn" text="Return Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </TableView>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="55.0" prefWidth="800.0">
         <children>
            <Button mnemonicParsing="false" onAction="#extendBorrow" prefHeight="32.0" prefWidth="112.0" styleClass="menu-button" text="Extend book" />
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="82.0" prefWidth="800.0">
         <children>
            <HBox alignment="CENTER" prefHeight="32.0" prefWidth="800.0" spacing="20.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="140.0" styleClass="headlines" text="Book Name:">
                     <font>
                        <Font name="Assistant SemiBold" size="19.0" />
                     </font>
                  </Label>
                  <TextField fx:id="bookNameTxt" prefHeight="18.0" prefWidth="254.0" styleClass="text-field" />
               </children>
            </HBox>
            <RadioButton fx:id="overdueRadioBtn" mnemonicParsing="false" text="Overdue">
               <VBox.margin>
                  <Insets bottom="20.0" top="10.0" />
               </VBox.margin>
            </RadioButton>
         </children>
      </VBox>
   </children>
</VBox>