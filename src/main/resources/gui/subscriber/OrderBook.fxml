<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@OrderBook.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.subscriber.OrderBookController">
   <children>
      <VBox alignment="CENTER" prefHeight="45.0" prefWidth="800.0">
         <children>
            <Label styleClass="label-text" text="My Orders">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="224.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER" prefHeight="158.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="orderTable" prefHeight="142.0" prefWidth="610.0" styleClass="table-row-cell" HBox.hgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="bookIDColumn" text="BookID" />
                        <TableColumn fx:id="bookNameColumn" text="Name" />
                        <TableColumn fx:id="arrivedStatusColumn" text="Arrived?" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" />
                     </HBox.margin>
                  </TableView>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="800.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#cancelOrderedBook" prefHeight="30.0" prefWidth="153.0" styleClass="menu-button" text="Cancel order" />
                  <Button mnemonicParsing="false" onAction="#handleReorderClick" prefHeight="30.0" prefWidth="152.0" styleClass="menu-button" text="Re-order book" />
               </children>
               <VBox.margin>
                  <Insets bottom="15.0" top="15.0" />
               </VBox.margin>
            </HBox>
            <Line endX="100.0" startX="-693.431640625" startY="0.17157280445098877" />
         </children>
      </VBox>
      <VBox alignment="TOP_CENTER" prefHeight="228.0" prefWidth="800.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="35.0" prefWidth="442.0" styleClass="label-text" text="Order a book now!">
               <font>
                  <Font size="30.0" />
               </font>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Label>
            <VBox prefHeight="193.0" prefWidth="800.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="84.0" prefWidth="800.0" spacing="20.0">
                     <children>
                        <VBox alignment="CENTER" prefHeight="122.0" prefWidth="399.0" spacing="12.0">
                           <children>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label text="Book name:">
                                       <font>
                                          <Font size="20.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="bookNameTxt" prefWidth="250.0" styleClass="text-field" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER" spacing="39.0">
                                 <children>
                                    <Label text="Book ID:">
                                       <font>
                                          <Font size="20.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="bookIDTxt" prefWidth="250.0" styleClass="text-field" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#searchOrderBook" prefHeight="30.0" prefWidth="147.0" styleClass="menu-button" text="Search book" />
                     </children>
                  </HBox>
                  <VBox prefHeight="104.0" prefWidth="800.0">
                     <children>
                        <VBox alignment="TOP_CENTER" prefHeight="98.0" prefWidth="800.0">
                           <children>
                              <HBox alignment="CENTER" prefHeight="40.0" prefWidth="800.0">
                                 <children>
                                    <Label fx:id="foundLabel2" style="-fx-font-weight: bold;" styleClass="label-text" text="Found book:">
                                       <font>
                                          <Font name="Assistant SemiBold" size="20.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="foundLabel" styleClass="text" text="text">
                                       <font>
                                          <Font size="20.0" />
                                       </font>
                                       <HBox.margin>
                                          <Insets left="10.0" />
                                       </HBox.margin>
                                    </Label>
                                 </children>
                              </HBox>
                              <Button fx:id="orderBtn" mnemonicParsing="false" onAction="#orderBook" prefHeight="31.0" prefWidth="136.0" styleClass="menu-button" text="Order book">
                                 <VBox.margin>
                                    <Insets top="15.0" bottom="20.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>