<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@PersonalInfo.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.subscriber.PersonalInfoController">
   <children>
      <VBox prefHeight="86.0" prefWidth="800.0">
         <children>
            <HBox prefHeight="98.0" prefWidth="782.0" spacing="34.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="63.0" prefWidth="377.0" spacing="6.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="23.0" prefWidth="162.0" styleClass="label-text" text="Membership Number:">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtMembershipNumber" alignment="CENTER" disable="true" editable="false" prefHeight="32.0" prefWidth="152.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="85.0" prefWidth="446.0" spacing="10.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="30.0" prefWidth="159.0" styleClass="label-text" text="Member freeze status:">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtFreezeStatus" alignment="CENTER" disable="true" editable="false" prefHeight="33.0" prefWidth="174.0" promptText="Freeze status" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="93.0" prefWidth="800.0">
         <children>
            <HBox alignment="CENTER" prefHeight="152.0" prefWidth="800.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="92.0" prefWidth="414.0" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER" prefHeight="31.0" prefWidth="379.0">
                           <children>
                              <Label prefHeight="23.0" prefWidth="130.0" styleClass="label-text" text="Phone Number:">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                                 <HBox.margin>
                                    <Insets right="10.0" />
                                 </HBox.margin>
                              </Label>
                              <TextField fx:id="txtPhoneNumber" disable="true" editable="false" prefHeight="32.0" prefWidth="183.0">
                                 <cursor>
                                    <Cursor fx:constant="TEXT" />
                                 </cursor>
                              </TextField>
                           </children>
                        </HBox>
                        <Button fx:id="btnUpdatePhoneNumber" alignment="CENTER" contentDisplay="BOTTOM" onAction="#handleUpdatePhoneNumberBtn" prefHeight="30.0" prefWidth="184.0" styleClass="menu-button" text="Update Phone Number">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <effect>
                              <Glow />
                           </effect>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="92.0" prefWidth="447.0" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="382.0" spacing="10.0">
                           <children>
                              <Label prefHeight="23.0" prefWidth="122.0" styleClass="label-text" text="Email Address:">
                                 <font>
                                    <Font name="Assistant Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtEmail" disable="true" editable="false" prefHeight="33.0" prefWidth="265.0">
                                 <cursor>
                                    <Cursor fx:constant="TEXT" />
                                 </cursor>
                              </TextField>
                           </children>
                        </HBox>
                        <Button fx:id="btnUpdateEmail" alignment="CENTER" contentDisplay="BOTTOM" onAction="#handleUpdateEmailBtn" prefHeight="30.0" prefWidth="150.0" styleClass="menu-button" text="Update Email">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <effect>
                              <Glow />
                           </effect>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="label-text" text="Activities:">
               <VBox.margin>
                  <Insets left="17.0" />
               </VBox.margin>
            </Label>
            <TableView fx:id="tableActivities" prefHeight="274.0" prefWidth="779.0" styleClass="table-view" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colActivityDate" prefWidth="150.0" text="Date &amp; Time" />
                  <TableColumn fx:id="colActivityType" prefWidth="150.0" text="Activity Type" />
                  <TableColumn fx:id="colActivityDesc" prefWidth="479.0" text="Description" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>