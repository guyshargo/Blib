<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="root-container" stylesheets="@BookDetails.css" spacing="40.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.catalog.BookDetailsController">
   
   <!-- LEFT COLUMN: Physical Inventory & Actions -->
   <VBox spacing="20.0" prefWidth="280.0" alignment="TOP_CENTER">
      <ImageView fx:id="bookCover" fitHeight="400.0" fitWidth="280.0" preserveRatio="false" />
      
      <VBox styleClass="inventory-status-box" spacing="10.0" alignment="CENTER" prefWidth="280.0">
          <Label text="CURRENT STATUS" styleClass="metadata-title" />
          <Label fx:id="BookStatus" text="Checking..." styleClass="status-label-available" />
          
          <HBox alignment="CENTER" spacing="10.0">
              <Label text="Location:" styleClass="metadata-title" />
              <Label fx:id="ShelfLocation" text="-" styleClass="metadata-value" />
          </HBox>
      </VBox>

      <Button text="Borrow Copy" styleClass="action-button" maxWidth="Infinity" />
   </VBox>

   <!-- RIGHT COLUMN: Book Information & Timeline -->
   <VBox spacing="25.0" HBox.hgrow="ALWAYS">
      
      <VBox spacing="5.0">
         <Label fx:id="bookName" text="Book Title" styleClass="book-title" wrapText="true" />
         <Label fx:id="authorLabel" text="by Author Name" styleClass="book-author" />
      </VBox>

      <VBox spacing="10.0">
         <Label text="Summary" styleClass="section-header" />
         <TextArea fx:id="summaryTxt" editable="false" wrapText="true" prefHeight="200.0" styleClass="summary-text" />
      </VBox>

      <!-- Waitlist / Return Timeline -->
      <VBox styleClass="timeline-box" spacing="10.0">
         <Label text="Return Timeline" styleClass="section-header" />
         <HBox spacing="15.0" alignment="CENTER_LEFT">
             <Label text="Closest Return Date:" styleClass="metadata-title" />
             <Label fx:id="ReturnDate" text="-" styleClass="metadata-value" />
         </HBox>
      </VBox>
      
   </VBox>
</HBox>