<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@SearchCatalog.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.catalog.SearchCatalogController">
   <children>
      <VBox alignment="CENTER" prefHeight="220.0" prefWidth="635.0" spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER" prefHeight="45.0" prefWidth="800.0">
               <children>
                   <Text fx:id="resultText" styleClass="label-text" text="Book Name:" wrappingWidth="155.60002441406243" />
                   <TextField fx:id="SearchBookByName" prefHeight="35.0" prefWidth="280.0" promptText="Enter Book Name" styleClass="text-field" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="45.0" prefWidth="800.0">
               <children>
                  <Text fx:id="resultText1" styleClass="label-text" text="Book Genre:" wrappingWidth="155.60002441406255" />
                   <TextField fx:id="SearchBookByGenre" prefHeight="35.0" prefWidth="280.0" promptText="Enter Book Genre" styleClass="text-field" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="45.0" prefWidth="800.0">
               <children>
                   <Text styleClass="label-text" strokeType="OUTSIDE" strokeWidth="0.0" text="Free Text:" wrappingWidth="155.60002441406243" />
                   <TextField fx:id="SearchBookByText" prefHeight="35.0" prefWidth="280.0" promptText="Enter Free Text" styleClass="text-field" />
               </children>
            </HBox>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </VBox>
      <VBox alignment="CENTER" prefHeight="341.0" prefWidth="800.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
             <Button fx:id="searchButton" onAction="#handleSearchAction" prefHeight="37.0" prefWidth="83.0" styleClass="menu-button" text="Search">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER" prefHeight="225.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="searchBookTable" prefHeight="226.0" prefWidth="742.0" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="bookName" prefWidth="75.0" text="Book Name" />
                        <TableColumn fx:id="bookGenre" prefWidth="91.20001220703125" text="Book Genre" />
                        <TableColumn fx:id="keywords" prefWidth="75.0" text="Keywords" />
                        <TableColumn fx:id="BookSummary" prefWidth="75.0" text="Book Summary" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <HBox.margin>
                        <Insets left="20.0" right="20.0" bottom="20.0" />
                     </HBox.margin>
                  </TableView>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>