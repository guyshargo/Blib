<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@ManageMember.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.librarian.ManageMemberController">
   <children>
      <VBox alignment="CENTER" prefHeight="82.0" prefWidth="800.0">
         <children>
            <HBox alignment="CENTER" prefHeight="162.0" prefWidth="800.0" spacing="25.0">
               <children>
                  <Label styleClass="label-text" text="Search members:" />
                  <TextField fx:id="membershipNumberSearchField" prefHeight="38.0" prefWidth="390.0" promptText="Enter member name or membership number" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="356.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER" prefHeight="357.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="subscriberTable" prefHeight="352.0" prefWidth="698.0" HBox.hgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="membershipNumberColumn" text="Membership Number" />
                        <TableColumn fx:id="nameColumn" text="Name" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="62.0" prefWidth="800.0">
         <children>
            <Button fx:id="scanReaderCard" mnemonicParsing="false" onAction="#scanReaderCard" prefHeight="35.0" prefWidth="190.0" styleClass="menu-button" text="Scan Reader Card" />
         </children>
      </VBox>
   </children>
</VBox>