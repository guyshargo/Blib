<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@Invoice.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.librarian.InvoiceController">
   <children>
      <TableView fx:id="invoiceTable" layoutX="75.0" layoutY="25.0" prefHeight="234.0" prefWidth="669.0">
         <columns>
            <TableColumn fx:id="subjectColumn" text="Subject" />
            <TableColumn fx:id="usernameColumn" text="Username" />
            <TableColumn fx:id="nameColumn" text="Name" />
            <TableColumn fx:id="dateColumn" text="Date" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" layoutY="340.0" prefHeight="30.0" prefWidth="798.0" spacing="20.0">
         <children>
            <HBox alignment="CENTER" spacing="7.0">
               <children>
                  <Label styleClass="label-text" text="From:" />
                  <TextField fx:id="fromTxt" editable="false" prefHeight="30.0" prefWidth="150.0" styleClass="text-field">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="7.0">
               <children>
                  <Label styleClass="label-text" text="Subject:" />
                  <TextField fx:id="subjectTxt" alignment="CENTER" editable="false" prefHeight="30.0" prefWidth="150.0" styleClass="text-field" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="7.0">
               <children>
                  <Label styleClass="label-text" text="Date:" />
                  <TextField fx:id="dateTxt" alignment="CENTER" editable="false" prefHeight="30.0" prefWidth="150.0" styleClass="text-field">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>
         </children>
      </HBox>
      <RadioButton fx:id="unreadRadioBtn" layoutX="355.0" layoutY="281.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="204.0" styleClass="label-text" text="Unread Messages" />
      <Label layoutX="284.0" layoutY="281.0" prefHeight="26.0" prefWidth="61.0" styleClass="label-text" text="Show:" />
      <TextArea fx:id="descriptionTxt" editable="false" layoutX="48.0" layoutY="391.0" prefHeight="164.0" prefWidth="715.0" wrapText="true">
         <font>
            <Font size="20.0" />
         </font>
      </TextArea>
   </children>
</AnchorPane>