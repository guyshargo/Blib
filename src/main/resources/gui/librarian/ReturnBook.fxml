<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" stylesheets="@ReturnBook.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.librarian.ReturnBookController">
   <children>
      <VBox prefHeight="453.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="TOP_CENTER">
               <children>
                  <HBox alignment="CENTER" prefHeight="118.0" prefWidth="800.0">
                     <children>
                        <VBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label fx:id="extendLabel11" prefHeight="30.0" prefWidth="191.0" styleClass="label-text" text="Membership Number:" textAlignment="CENTER">
                                       <font>
                                          <Font size="13.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="MemberNumTextField" prefWidth="174.0" styleClass="text-field" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label prefHeight="26.0" prefWidth="190.0" styleClass="label-text" text="Member name:" />
                                    <TextField fx:id="memberNameTxt" disable="true" editable="false" styleClass="text-field" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#handleSearchBorrowedBooksForMember" prefHeight="26.0" prefWidth="94.0" styleClass="menu-button" text="Find">
                           <HBox.margin>
                              <Insets left="25.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="BorrowedBooksTable" prefHeight="327.0" prefWidth="778.0" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="BookIdColumn" prefWidth="188.79999083280563" text="Copy of book ID" />
                      <TableColumn fx:id="BookNameColumn" prefWidth="587.1999969482422" text="Book Name" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <HBox.margin>
                        <Insets bottom="20.0" left="10.0" right="10.0" />
                     </HBox.margin>
                  </TableView>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>