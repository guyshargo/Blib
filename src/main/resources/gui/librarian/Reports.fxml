<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@Reports.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.librarian.ReportsPageController">
    <children>
        <VBox prefHeight="310.0" prefWidth="800.0" spacing="10.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER" prefHeight="48.0" prefWidth="894.0" spacing="30.0">
                <ComboBox fx:id="monthComboBox" prefHeight="35.0" prefWidth="150.0" promptText="Select Month" styleClass="combo-box" />
                <ComboBox fx:id="yearComboBox" prefHeight="35.0" prefWidth="146.0" promptText="Select Year" styleClass="combo-box" />
                <ComboBox fx:id="reportTypeComboBox" prefHeight="35.0" prefWidth="220.0" promptText="Select Report Type" styleClass="combo-box" />
                <Button onAction="#handleGenerateReport" prefHeight="32.0" prefWidth="142.0" styleClass="menu-button" text="Generate Report" HBox.hgrow="ALWAYS" />
                <padding>
                    <Insets top="20.0" />
                </padding>
            </HBox>

            <StackPane prefHeight="230.0" prefWidth="894.0">
                <!-- Borrow History Table -->
                <TableView fx:id="borrowHistoryTable" prefHeight="230.0" prefWidth="871.0">
                    <columns>
                        <TableColumn fx:id="borrowMembershipNumberColumn" prefWidth="145.60000228881836" text="Membership Number" />
                        <TableColumn fx:id="borrowMemberNameColumn" prefWidth="106.39997863769531" text="Member Name" />
                        <TableColumn fx:id="bookNameColumn" prefWidth="91.99998474121094" text="Book Name" />
                        <TableColumn fx:id="borrowDateColumn" prefWidth="116.0" text="Borrow Date" />
                        <TableColumn fx:id="originalReturnDateColumn" prefWidth="148.79998779296875" text="Original Return Date" />
                        <TableColumn fx:id="actualReturnDateColumn" prefWidth="141.60003662109375" text="Actual Return Date" />
                        <TableColumn fx:id="lateDaysColumn" prefWidth="110.39990234375" text="Late Days" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <StackPane.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                    </StackPane.margin>
                </TableView>
                
                <!-- Member Status Table -->
                <TableView fx:id="memberStatusTable" prefHeight="230.0" prefWidth="873.0">
                    <columns>
                        <TableColumn fx:id="membershipNumberColumn" prefWidth="190.3999900817871" text="Membership Number" />
                        <TableColumn fx:id="memberNameColumn" minWidth="0.0" prefWidth="205.59999084472656" text="Member Name" />
                        <TableColumn fx:id="freezeStatusColumn" prefWidth="221.5999755859375" text="Freeze Status" />
                        <TableColumn fx:id="savedStatusDateColumn" prefWidth="245.59991455078125" text="Saved Status Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <StackPane.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                    </StackPane.margin>
                </TableView>
            </StackPane>
        </VBox>

        <!-- Borrow History BarChart for Daily Data -->
        <BarChart fx:id="borrowDatesBarChart" layoutX="10.0" layoutY="330.0" prefHeight="245.0" prefWidth="780.0" title="Book Borrowing and Return Statistics by Day" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <xAxis>
                <CategoryAxis fx:id="daysAxis" label="Days" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="countAxis" label="Book Counts" />
            </yAxis>
        </BarChart>
        
        <!-- Freeze Status BarChart for Daily Data -->
        <BarChart fx:id="freezeStatusBarChart" layoutX="10.0" layoutY="330.0" prefHeight="245.0" prefWidth="780.0" title="Members Freeze Status Statistics by Day" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <xAxis>
                <CategoryAxis fx:id="daysAxisFreeze" label="Days" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="countAxisFreeze" label="Member Count" />
            </yAxis>
        </BarChart>
    </children>
</AnchorPane>